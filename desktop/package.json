{
  "name": "anti-social",
  "productName": "Anti-Social",
  "version": "0.22.0",
  "description": "Social media with nobody on it.",
  "author": {
    "name": "Gamehopper",
    "email": "nobody@anti-social.invalid"
  },
  "homepage": "https://anti-social.invalid",
  "license": "GPL-2.0-only",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare-assets": "node prepare.js",
    "start": "npm run prepare-assets && electron .",
    "dist": "npm run prepare-assets && electron-builder --publish never",
    "dist:linux": "npm run prepare-assets && electron-builder --linux --publish never",
    "dist:win": "npm run prepare-assets && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.antisocial.app",
    "productName": "Anti-Social",
    "files": [
      "main.js",
      "preload.js",
      "ai-engine.mjs",
      "www/**/*",
      "node_modules/**/*",
      "!node_modules/node-llama-cpp/llama/{llama.cpp,addon,cmake,gitRelease.bundle,CMakeLists.txt,localBuilds}/**",
      "!node_modules/node-llama-cpp/llama/{gitRelease.bundle,CMakeLists.txt}",
      "!node_modules/@node-llama-cpp/*cuda*/**",
      "!node_modules/@node-llama-cpp/*-arm*/**",
      "!node_modules/@node-llama-cpp/mac-*/**",
      "!node_modules/**/*.{md,markdown,map,ts}",
      "!node_modules/.bin/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "Anti-Social-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Anti-Social-Setup-${version}-win-${arch}.${ext}"
    },
    "publish": null,
    "portable": {
      "artifactName": "Anti-Social-${version}-win-${arch}-portable.${ext}"
    },
    "asar": false,
    "npmRebuild": false
  },
  "dependencies": {
    "node-llama-cpp": "3.22.2"
  }
}
